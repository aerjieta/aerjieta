    {
      "headers": [
        {
          "source": "/(.*)",  // 这表示所有的文件或路由
          "headers": [
            {
              "key": "Access-Control-Allow-Origin",
              "value": "https://pikpak.zhiyi.workers.dev"  // 只允许这个域名的跨域请求
            },
            {
              "key": "Access-Control-Allow-Methods",
              "value": "GET, POST, PUT, DELETE, OPTIONS"  // 允许的HTTP请求方法
            },
            {
              "key": "Access-Control-Allow-Headers",
              "value": "X-Requested-With, content-type, Authorization"  // 允许的HTTP头
            }
          ]
        }
      ]
    }