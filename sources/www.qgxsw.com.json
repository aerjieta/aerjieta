{
  "name": "情感小说网",
  "version": 100,
  "category": 1,
  "url": "https://www.qgxsw.com",
  "charset": "utf-8",
  "search": {
    "url": "https://www.qgxsw.com/search.html",
    "method": "post",
    "data": "s=${key}",
    "list": "ul.txt-list > li",
    "name": "span.s2 > a",
    "author": "span.s3 > a",
    "detail": "span.s2 > a"
  },
  "detail": {
    "name": "div.top > h1",
    "author": "div.fix > p:nth-child(1)",
    "cover": "div.imgbox > img",
    "summary": "div.desc",
    "catalog": ""
  },
  "catalog": {
    "list": "ul.section-list > li",
    "orderBy": 0,
    "name": "a",
    "chapter": "a"
  },
  "chapter": {
    "content": "div.word_read",
    "filter": [
      "@script",
      "@div.read_btn",
      "@p:matches(请勿开启浏览器阅读模式)"
    ]
  }
}
